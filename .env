# --- Serveur ---
PORT=4000
NODE_ENV=production

# --- Base de données ---
MONGO_URI=mongodb://127.0.0.1:27017/syrixflix

# --- Auth ---
JWT_SECRET=change_this_super_secret_value
JWT_EXPIRES_IN=30d

# --- Source du catalogue (API publique SYRIX FLIX déjà en place sur le VPS) ---
CATALOG_API_BASE_URL=http://82.165.215.121:3005/api/v1

# --- Sécurité clé API développeur ---
# En dev, on peut désactiver la vérification stricte du domaine (utile avec Postman/localhost)
API_KEY_DOMAIN_ENFORCEMENT=true
