# Port the web pairing site + API listens on (Railway sets this automatically)
PORT=3000

# pino log level for Baileys (silent, error, warn, info, debug, trace)
LOG_LEVEL=silent

# WhatsApp number (digits only) allowed to run owner-only commands
OWNER_NUMBER=

# Force-join gate
FORCE_CHANNEL_LINK=
FORCE_GROUP_LINK=
FORCE_JOIN=true

# Menu / branding
MENU_IMAGE_URL=
# MENU_IMAGE_URL accepts an https:// URL or a local file path, e.g. /app/public/menu.jpg
CHANNEL_NAME=INCONNU XD V2

ANTICALL=true
PREFIX=.
MENU_STYLE=classic

# Telegram Bot API token used by .telegram/.tlg/.tg to fetch sticker packs
TELEGRAM_BOT_TOKEN=8541586834:AAGd4NtPWsjXLrXyfZQOUDmO08bY8zIEuDM

